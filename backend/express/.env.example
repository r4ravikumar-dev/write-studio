# Express API (backend/express). Copy to backend/express/.env

PORT=4000
# The Next.js site, the only browser origin allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# Supabase -> Project Settings -> API keys. The secret (service-role) key
# bypasses row-level security: keep it on this server only, never in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Must match the Django auth service and the Next.js app.
JWT_SECRET=generate-with-openssl-rand-base64-48
