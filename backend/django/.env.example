# Django auth service (backend/django). Copy to backend/django/.env

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,auth.your-domain.com

# Supabase Postgres (Project Settings -> Database -> Connection string, URI).
# Django keeps its tables in the `django` schema (see supabase/migrations/0004_split_backends.sql).
# Leave empty to use a local SQLite file in development.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
DJANGO_DB_SCHEMA=django


# Shared secrets (must match the Express API and the Next.js app).
JWT_SECRET=generate-with-openssl-rand-base64-48
AUTH_SERVICE_KEY=generate-with-openssl-rand-base64-32

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# The Next.js site, for links in emails (confirm address, reset password).
FRONTEND_URL=http://localhost:3000

# Email (codes, confirmations, resets). For public sign-ups use a transactional
# provider via SMTP_*; Gmail allows ~500 emails/day. With neither set, emails are
# printed to the console (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Studio <no-reply@your-domain.com>
GMAIL_USER=
GMAIL_APP_PASSWORD=
