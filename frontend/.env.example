# Next.js frontend. Copy to frontend/.env.local (and add the same where you host it).
# All server-only: nothing here reaches the browser. The frontend holds no Supabase
# keys or URLs; every file loads through the session-checked /studio/files route.

# The Express API (workspaces, case studies, media).
API_URL=http://localhost:4000
# The Django auth service (accounts, sign-in, tokens).
AUTH_URL=http://localhost:8000

# Must match the Django auth service (and JWT_SECRET the Express API).
JWT_SECRET=generate-with-openssl-rand-base64-48
AUTH_SERVICE_KEY=generate-with-openssl-rand-base64-32

# Bot protection (Cloudflare Turnstile) on sign-up, "Email me a code" and "Forgot your password".
# Cloudflare dashboard -> Turnstile -> Add widget (Managed). Both set = on; leave empty locally.
# Test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always passes).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production only: the one public address. Other hosts redirect here (the Turnstile widget and
# sign-in cookies belong to one hostname). Leave empty locally.
SITE_URL=

# Contact page: the address the contact form drafts an email to (it opens the visitor's own
# email app; nothing is sent by the server). Empty = the page shows "not available yet".
SUPPORT_EMAIL=
