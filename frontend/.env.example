# Next.js frontend. Copy to frontend/.env.local (and add the same where you host it).
# All server-only: nothing here reaches the browser. The frontend holds no Supabase
# keys or URLs; every file loads through the session-checked /studio/files route.

# The Express API (workspaces, case studies, media).
API_URL=http://localhost:4000
# The Django auth service (accounts, sign-in, tokens).
AUTH_URL=http://localhost:8000

# Must match the Django auth service (and JWT_SECRET the Express API).
JWT_SECRET=generate-with-openssl-rand-base64-48
AUTH_SERVICE_KEY=generate-with-openssl-rand-base64-32
